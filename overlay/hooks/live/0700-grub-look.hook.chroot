#!/bin/sh
# Фон меню GRUB после установки на диск — GeOS вместо Debian
if [ -e /usr/share/images/desktop-base/desktop-grub.png ] || update-alternatives --list desktop-grub >/dev/null 2>&1; then
  update-alternatives --install /usr/share/images/desktop-base/desktop-grub.png desktop-grub \
    /usr/share/images/geos/grub.png 100 || true
  update-alternatives --set desktop-grub /usr/share/images/geos/grub.png || true
fi
