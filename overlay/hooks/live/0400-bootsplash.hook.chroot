#!/bin/sh
# Заставка загрузки GeOS (тема на «скриптах» — со своими картинками, без зависимости от других тем)
T=/usr/share/plymouth/themes/geos
mkdir -p /etc/plymouth
printf '[Daemon]\nTheme=geos\nShowDelay=0\nDeviceTimeout=8\n' > /etc/plymouth/plymouthd.conf
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$T/geos.plymouth" 300 2>/dev/null || true
update-alternatives --set default.plymouth "$T/geos.plymouth" 2>/dev/null || true
plymouth-set-default-theme geos || echo "ВНИМАНИЕ: тема загрузки не применилась"
true
