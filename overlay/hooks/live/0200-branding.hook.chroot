#!/bin/sh
# Оформление GeOS
set -e
chmod +x /usr/local/sbin/geos-branding
systemctl enable geos-branding.service
echo 'GeOS \n \l' > /etc/issue
mkdir -p /etc/skel/.config
cat > /etc/skel/.config/kdeglobals << 'CFG'
[General]
ColorScheme=GeOSBlue
AccentColor=37,99,235
CFG
# Ускорение: сжатие памяти и защита от зависаний
systemctl enable zramswap.service earlyoom.service || true
