#!/bin/sh
# Название системы и синяя тема по умолчанию
set -e
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="GeOS (GeshanOS)"/; s/^NAME=.*/NAME="GeOS"/' /usr/lib/os-release
echo 'GeOS \n \l' > /etc/issue
mkdir -p /etc/skel/.config
cat > /etc/skel/.config/kdeglobals << 'CFG'
[General]
ColorScheme=GeOSBlue
AccentColor=37,99,235
CFG
