#!/bin/sh
# Меню загрузки ISO (самый первый экран): убираем надписи Debian и непонятное «amd64».
# Пункты латиницей: старый загрузчик BIOS не умеет русские буквы.
# Хук запускается уже после того, как live-build написал меню GRUB (UEFI) и ISOLINUX (BIOS).
B=.
[ -d binary ] && B=binary
REPORT=../chroot/usr/share/geos/build-report.txt
[ -d chroot ] && REPORT=chroot/usr/share/geos/build-report.txt

# Картинка меню: live-build рисует свою (жёлтая каска и «Debian GNU/Linux 13»), заменяем на GeOS
SPLASH=""
for c in ../config/geos-splash.png config/geos-splash.png; do [ -f "$c" ] && SPLASH="$c" && break; done
SPL_N=0
if [ -n "$SPLASH" ]; then
  for p in $(find "$B" -path "$B/live" -prune -o -type f -iname 'splash*.png' -print 2>/dev/null); do
    cp "$SPLASH" "$p" && SPL_N=$((SPL_N+1))
  done
  for p in $(find "$B" -path "$B/live" -prune -o -type f -iname 'splash*.svg' -print 2>/dev/null); do rm -f "$p"; done
else
  echo "ВНИМАНИЕ: картинка меню загрузки GeOS не найдена"
fi

FILES=$(find "$B/boot" "$B/isolinux" "$B/syslinux" "$B/EFI" -type f \( -name '*.cfg' -o -name 'theme.txt' \) 2>/dev/null)
[ -n "$FILES" ] || { echo "ВНИМАНИЕ: файлы меню загрузки не найдены"; exit 0; }

for f in $FILES; do
  sed -i \
    -e 's/Debian GNU\/Linux[^"]*Live[^"]*/GeOS/g' \
    -e 's/Debian GNU\/Linux/GeOS/g' \
    -e 's/Debian Live/GeOS/g' \
    -e 's/Live system/GeOS/g' \
    -e 's/GeOS (\([a-z0-9_]*\) fail-safe mode)/GeOS (safe mode)/g' \
    -e 's/GeOS (\([a-z0-9_]*\) failsafe)/GeOS (safe mode)/g' \
    -e 's/Live (\([a-z0-9_]*\) failsafe)/GeOS (safe mode)/g' \
    -e 's/GeOS (\([a-z0-9_]*\))/Start GeOS/g' \
    -e 's/Live (\([a-z0-9_]*\))/Start GeOS/g' \
    -e 's/\^Live/^GeOS/g' \
    -e 's/Boot menu/GeOS/g' \
    -e 's/Live Boot Menu with GRUB/GeOS/g' \
    -e 's/title-text: *".*"/title-text: "GeOS"/' \
    -e 's/Debian/GeOS/g' \
    "$f"
done

# Пункт «Install GeOS»: копия «Start GeOS» с параметром geos-install (сразу открывается установщик)
# и удаление пунктов установщика Debian — его в GeOS нет, эти пункты не работают
for f in $FILES; do
  case "$f" in
    *isolinux*|*syslinux*)
      grep -q "Start GeOS" "$f" || continue
      awk '
        function flush() {
          if (blk == "") return
          printf "%s", blk
          if (blk ~ /Start GeOS/ && blk !~ /geos-install/) {
            n = split(blk, L, "\n"); out = ""
            for (i = 1; i < n; i++) {
              l = L[i]
              if (l ~ /^label /) l = "label geos-install"
              else if (l ~ /menu label/) sub(/\^?Start GeOS/, "^Install GeOS", l)
              else if (l ~ /menu default/) continue
              else if (l ~ /^[ \t]*append /) l = l " geos-install"
              out = out l "\n"
            }
            printf "\n%s", out
          }
          blk = ""
        }
        /^label / { flush() }
        { blk = blk $0 "\n" }
        END { flush() }
      ' "$f" > "$f.new" && mv "$f.new" "$f"
      ;;
    *)
      # GRUB: блоки menuentry "..." { ... }
      awk '
        function flush() {
          if (blk == "") return
          if (title ~ /Alternate (graphical|textual) installer|Graphical install|^Install$|Text install/) { blk = ""; return }
          printf "%s", blk
          if (title == "Start GeOS" && blk !~ /geos-install/) {
            c = blk
            sub(/"Start GeOS"/, "\"Install GeOS\"", c)
            gsub(/--hotkey=l/, "--hotkey=i", c)
            n = split(c, L, "\n"); out = ""
            for (i = 1; i < n; i++) { l = L[i]; if (l ~ /^[ \t]*linux[ \t]/) l = l " geos-install"; out = out l "\n" }
            printf "%s", out
          }
          blk = ""
        }
        inb == 0 && /^[ \t]*menuentry[ \t]+"/ {
          t = $0; sub(/^[ \t]*menuentry[ \t]+"/, "", t); sub(/".*/, "", t); title = t
          inb = 1; blk = $0 "\n"
          if ($0 ~ /}[ \t]*$/ && $0 ~ /{/) { inb = 0; flush() }
          next
        }
        inb == 1 { blk = blk $0 "\n"; if ($0 ~ /^[ \t]*}[ \t]*$/) { inb = 0; flush() }; next }
        { print }
        END { if (blk != "") printf "%s", blk }
      ' "$f" > "$f.new" && mv "$f.new" "$f"
      ;;
  esac
done

# Что осталось в заголовках и пунктах меню — в отчёт сборки
LEFT=$(grep -h -i "debian" $FILES 2>/dev/null | head -5)
ITEMS=$(grep -h -o -E '(menuentry|menu label|title-text)[^{]*' $FILES 2>/dev/null | sort -u | head -12 | tr '\n' ';')
if [ -f "$REPORT" ]; then
  if [ -z "$LEFT" ]; then
    echo "[OK] Меню загрузки ISO без надписей Debian" >> "$REPORT"
  else
    echo "[!!] В меню загрузки осталось: $LEFT" >> "$REPORT"
  fi
  echo "     Пункты меню: $ITEMS" >> "$REPORT"
  if [ "$SPL_N" -gt 0 ]; then echo "[OK] Картинка меню загрузки GeOS (заменено файлов: $SPL_N)" >> "$REPORT"
  else echo "[!!] Картинка меню загрузки не заменена" >> "$REPORT"; fi
fi
[ -z "$LEFT" ] || echo "ВНИМАНИЕ: в меню загрузки осталось слово Debian: $LEFT"
true
