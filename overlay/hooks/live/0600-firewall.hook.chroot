#!/bin/sh
# Брандмауэр как в Windows: входящие подключения закрыты, исходящие разрешены.
# Открыто только нужное: связь с телефоном (KDE Connect) и сеть для Android (Waydroid).
cat > /tmp/fw.sh << 'SCRIPT'
set -e
ufw default deny incoming
ufw default allow outgoing
ufw allow 1714:1764/udp comment 'KDE Connect'
ufw allow 1714:1764/tcp comment 'KDE Connect'
ufw allow in on waydroid0 comment 'Android'
ufw route allow in on waydroid0
ufw route allow out on waydroid0
sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="ACCEPT"/' /etc/default/ufw
sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
systemctl enable ufw
SCRIPT
sh /tmp/fw.sh || echo "ВНИМАНИЕ: брандмауэр не настроился, система будет без него"
rm -f /tmp/fw.sh
