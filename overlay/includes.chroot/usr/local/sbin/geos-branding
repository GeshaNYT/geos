#!/bin/sh
# Название GeOS в os-release. Сборщик Debian и обновления base-files перезаписывают
# этот файл, поэтому исправляем его при каждой загрузке.

# После установки на диск убираем настройку живого режима «после выхода сразу войти снова»
grep -q "boot=live" /proc/cmdline || rm -f /etc/sddm.conf.d/geos-live.conf
# Пробный режим (с флешки или ISO): экран не блокируется — пароль никто не задавал.
# Пишем в общие настройки до входа, чтобы блокировщик с самого начала их видел.
# В этом же файле лежат обои экрана блокировки, поэтому только дописываем строки, не перезаписывая.
# В установленную систему эти строки не попадают (установщик копирует систему без изменений пробного режима).
if grep -q "boot=live" /proc/cmdline && ! grep -qs '^Autolock=' /etc/xdg/kscreenlockerrc; then
  mkdir -p /etc/xdg
  printf '\n[Daemon]\nAutolock=false\nLockOnResume=false\n' >> /etc/xdg/kscreenlockerrc
fi
# После установки на диск ярлык «Установить GeOS» больше не нужен
grep -q "boot=live" /proc/cmdline || rm -f /usr/share/applications/install-geos.desktop
# Аватарка GeOS для пользователей, у которых своей нет (её видно на входе, в «Пуске» и при выключении)
for home in /home/*; do
  u=$(basename "$home"); id "$u" >/dev/null 2>&1 || continue
  [ -e "$home/.face" ] || { cp /usr/share/geos/avatar.png "$home/.face"; chown "$u:" "$home/.face"; }
  [ -e "$home/.face.icon" ] || { ln -s .face "$home/.face.icon"; chown -h "$u:" "$home/.face.icon"; }
  mkdir -p /var/lib/AccountsService/icons /var/lib/AccountsService/users
  if [ ! -s "/var/lib/AccountsService/icons/$u" ]; then
    cp /usr/share/geos/avatar.png "/var/lib/AccountsService/icons/$u"
    F="/var/lib/AccountsService/users/$u"
    [ -f "$F" ] || printf '[User]\n' > "$F"
    if grep -q '^Icon=' "$F"; then sed -i "s#^Icon=.*#Icon=/var/lib/AccountsService/icons/$u#" "$F"
    else sed -i "/^\[User\]/a Icon=/var/lib/AccountsService/icons/$u" "$F"; fi
  fi
done

grep -q '^NAME="GeOS"' /usr/lib/os-release 2>/dev/null && \
  grep -q '^NAME="GeOS"' /etc/os-release 2>/dev/null && exit 0
EXTRA=$(grep -hE '^(IMAGE_ID|BUILD_ID)=' /etc/os-release /usr/lib/os-release 2>/dev/null | sort -u)
TMP=/usr/lib/os-release.geos
cat > "$TMP" << OSR
PRETTY_NAME="GeOS 1.0 (GeshanOS)"
NAME="GeOS"
VERSION="1.0 (GeshanOS)"
VERSION_ID="13"
VERSION_CODENAME=trixie
ID=debian
LOGO=geos-logo
HOME_URL="https://github.com/GeshaNYT/geos"
SUPPORT_URL="https://github.com/GeshaNYT/geos/issues"
BUG_REPORT_URL="https://github.com/GeshaNYT/geos/issues"
$EXTRA
OSR
chmod 644 "$TMP"
mv -f "$TMP" /usr/lib/os-release
rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release
