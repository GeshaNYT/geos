#!/bin/sh
# Вызывает установщик GeOS кнопкой «Перезагрузить сейчас» после успешной установки.
# Ставим метку «установка завершена»: при перезагрузке geos-eject вынет установочный диск
# или попросит вынуть флешку. Метка лежит в /dev — эта папка живёт до самого конца выключения.
touch /dev/.geos-installed 2>/dev/null || true
exec systemctl reboot
