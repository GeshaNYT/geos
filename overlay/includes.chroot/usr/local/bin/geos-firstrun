#!/bin/sh
# Первый вход: оформление и привычные по Windows настройки. Потом всё можно поменять в «Параметрах».
FLAG="$HOME/.config/geos-firstrun-done"
[ -f "$FLAG" ] && exit 0
sleep 5
LIVE=false; grep -q "boot=live" /proc/cmdline && LIVE=true

plasma-apply-colorscheme GeOSBlue
plasma-apply-wallpaperimage /usr/share/wallpapers/GeOS

# Панель как в Windows 11: плавающая, по центру, закреплённые программы, дата под часами
dbus-send --session --type=method_call --dest=org.kde.plasmashell /PlasmaShell \
  org.kde.PlasmaShell.evaluateScript string:'
var ps = panels();
for (var i = 0; i < ps.length; i++) {
  var p = ps[i];
  if (p.location != "bottom") continue;
  p.floating = true;
  p.lengthMode = "fit";
  p.alignment = "center";
  p.height = 48;
  var k = p.widgets("org.kde.plasma.kickoff");
  for (var j = 0; j < k.length; j++) {
    k[j].currentConfigGroup = ["General"];
    k[j].writeConfig("icon", "/usr/share/pixmaps/geos-logo.png");
  }
  var t = p.widgets("org.kde.plasma.icontasks");
  for (var j = 0; j < t.length; j++) {
    t[j].currentConfigGroup = ["General"];
    t[j].writeConfig("launchers", ["applications:org.kde.dolphin.desktop", "applications:firefox-esr.desktop", "applications:geos-center.desktop", "applications:org.kde.discover.desktop", "applications:systemsettings.desktop"]);
  }
  var c = p.widgets("org.kde.plasma.digitalclock");
  for (var j = 0; j < c.length; j++) {
    c[j].currentConfigGroup = ["Appearance"];
    c[j].writeConfig("showDate", true);
    c[j].writeConfig("dateDisplayFormat", "BelowTime");
  }
}
// Большие часы на рабочем столе (справа сверху)
var d = desktops()[0];
if (d) {
  var g = screenGeometry(d.screen);
  var w = d.addWidget("org.kde.plasma.digitalclock", g.width - 480, 60, 420, 200);
  w.currentConfigGroup = ["Appearance"];
  w.writeConfig("showDate", true);
  w.writeConfig("dateDisplayFormat", "BelowTime");
  w.writeConfig("use24hFormat", 2);
}'

# Значки на рабочем столе, как в Windows
DESK=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
mkdir -p "$DESK"
cat > "$DESK/computer.desktop" << DSK
[Desktop Entry]
Type=Link
Name=Этот компьютер
Icon=computer
URL=file:///
DSK
cat > "$DESK/trash.desktop" << DSK
[Desktop Entry]
Type=Link
Name=Корзина
Icon=user-trash
URL=trash:/
DSK
cp /usr/share/applications/geos-center.desktop "$DESK/"
rm -f "$DESK"/*install-debian*.desktop "$DESK"/calamares*.desktop
if $LIVE && [ -f /usr/share/applications/install-geos.desktop ]; then
  cp /usr/share/applications/install-geos.desktop "$DESK/install-geos.desktop"
fi
chmod +x "$DESK"/*.desktop

HINT=""
if $LIVE; then
  # Живой режим (с флешки): экран не блокируется, пароль никто не задавал
  kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
  kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false
  # блокировщик перечитывает настройки сразу, а не при следующем входе
  dbus-send --session --type=method_call --dest=org.freedesktop.ScreenSaver /ScreenSaver org.kde.screensaver.configure 2>/dev/null || true
  # Автообновления в живом режиме бессмысленны (всё сбросится) и мешают выключению
  kwriteconfig6 --file PlasmaDiscoverUpdates --group Global --key UseUnattendedUpdates false
  HINT=" Пароль в живом режиме: live."
fi

touch "$FLAG"
# Пункт «Install GeOS» в меню загрузки — режим установки, как в Windows:
# установщик на весь экран (без рамки, панели и рабочего стола за ним),
# а если его закрыть — спрашиваем, что делать дальше
if $LIVE && grep -qw "geos-install" /proc/cmdline && [ -f /usr/share/applications/install-geos.desktop ]; then
  RID=geos-installer
  RULES=$(kreadconfig6 --file kwinrulesrc --group General --key rules)
  IDS=$(printf '%s' "$RULES" | tr ',' '\n' | grep -v -x -e "$RID" -e '' | tr '\n' ',')
  IDS="${IDS}${RID}"
  kwriteconfig6 --file kwinrulesrc --group General --key rules "$IDS"
  kwriteconfig6 --file kwinrulesrc --group General --key count "$(printf '%s' "$IDS" | tr ',' '\n' | grep -c .)"
  for kv in "Description=Установщик GeOS на весь экран" "wmclass=calamares" "wmclassmatch=2" \
            "fullscreen=true" "fullscreenrule=2" "above=true" "aboverule=2" \
            "skiptaskbar=true" "skiptaskbarrule=2"; do
    kwriteconfig6 --file kwinrulesrc --group "$RID" --key "${kv%%=*}" "${kv#*=}"
  done
  dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure 2>/dev/null || true

  EXEC=$(sed -n 's/^Exec=//p' /usr/share/applications/install-geos.desktop | head -1 | sed 's/ %[a-zA-Z]//g')
  sleep 1
  sh -c "$EXEC"

  # Установщик закрыт без перезагрузки — выбор, что дальше
  NEXT=$(kdialog --title "GeOS" --menu "Установщик закрыт. Что сделать?" \
          poweroff "Выключить компьютер" reboot "Перезагрузить" try "Попробовать GeOS (пробный режим)")
  case "$NEXT" in
    poweroff) systemctl poweroff; exit 0 ;;
    reboot)   systemctl reboot; exit 0 ;;
  esac
  # «Попробовать» — обычный пробный режим: убираем правило «на весь экран» и показываем приветствие
  kwriteconfig6 --file kwinrulesrc --group General --key rules "$(printf '%s' "$RULES")"
  kwriteconfig6 --file kwinrulesrc --group General --key count "$(printf '%s' "$RULES" | tr ',' '\n' | grep -c .)"
  kwriteconfig6 --file kwinrulesrc --group "$RID" --key fullscreenrule 0
  dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure 2>/dev/null || true
fi
notify-send -a "GeOS" -i geos-logo "Добро пожаловать в GeOS" \
  "Открываю Центр GeOS: там программы в один клик. .apk и .exe запускаются двойным кликом.$HINT"
/usr/local/bin/geos-center &
