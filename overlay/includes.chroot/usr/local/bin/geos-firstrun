#!/bin/sh
# Первый вход: оформление и привычные по Windows настройки. Потом всё можно поменять в «Параметрах».
FLAG="$HOME/.config/geos-firstrun-done"
[ -f "$FLAG" ] && exit 0
sleep 5
LIVE=false; grep -q "boot=live" /proc/cmdline && LIVE=true

plasma-apply-colorscheme GeOSBlue
plasma-apply-wallpaperimage /usr/share/wallpapers/GeOS

# Панель как в Windows 11: плавающая, по центру, закреплённые программы, дата под часами
dbus-send --session --type=method_call --dest=org.kde.plasmashell /PlasmaShell \
  org.kde.PlasmaShell.evaluateScript string:'
var ps = panels();
for (var i = 0; i < ps.length; i++) {
  var p = ps[i];
  if (p.location != "bottom") continue;
  p.floating = true;
  p.lengthMode = "fit";
  p.alignment = "center";
  p.height = 48;
  var k = p.widgets("org.kde.plasma.kickoff");
  for (var j = 0; j < k.length; j++) {
    k[j].currentConfigGroup = ["General"];
    k[j].writeConfig("icon", "/usr/share/pixmaps/geos-logo.png");
  }
  var t = p.widgets("org.kde.plasma.icontasks");
  for (var j = 0; j < t.length; j++) {
    t[j].currentConfigGroup = ["General"];
    t[j].writeConfig("launchers", "applications:org.kde.dolphin.desktop,applications:firefox-esr.desktop,applications:geos-center.desktop,applications:org.kde.discover.desktop,applications:systemsettings.desktop");
  }
  var c = p.widgets("org.kde.plasma.digitalclock");
  for (var j = 0; j < c.length; j++) {
    c[j].currentConfigGroup = ["Appearance"];
    c[j].writeConfig("showDate", true);
    c[j].writeConfig("dateDisplayFormat", "BelowTime");
  }
}'

# Значки на рабочем столе, как в Windows
DESK=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
mkdir -p "$DESK"
cat > "$DESK/computer.desktop" << DSK
[Desktop Entry]
Type=Link
Name=Этот компьютер
Icon=computer
URL=file:///
DSK
cat > "$DESK/trash.desktop" << DSK
[Desktop Entry]
Type=Link
Name=Корзина
Icon=user-trash
URL=trash:/
DSK
cp /usr/share/applications/geos-center.desktop "$DESK/"
if $LIVE && [ -f /usr/share/applications/install-debian.desktop ]; then
  cp /usr/share/applications/install-debian.desktop "$DESK/install-geos.desktop"
fi
chmod +x "$DESK"/*.desktop

HINT=""
if $LIVE; then
  # Живой режим (с флешки): экран не блокируется, пароль никто не задавал
  kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
  kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false
  HINT=" Пароль в живом режиме: live."
fi

touch "$FLAG"
notify-send -a "GeOS" -i geos-logo "Добро пожаловать в GeOS" \
  "Открываю Центр GeOS: там программы в один клик. .apk и .exe запускаются двойным кликом.$HINT"
/usr/local/bin/geos-center &
