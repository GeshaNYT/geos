#!/bin/sh
# Снимок экрана в GeOS Flow: в буфер обмена и в папку «Изображения/Снимки экрана»
DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Снимки экрана"
mkdir -p "$DIR"
FILE="$DIR/Снимок $(date +'%Y-%m-%d %H-%M-%S').png"
if [ "$1" = "area" ]; then
  AREA=$(slurp -b 0d1b3466 -c 3b82f6ff -w 2) || exit 0
  grim -g "$AREA" "$FILE" || exit 1
else
  grim "$FILE" || exit 1
fi
wl-copy < "$FILE"
notify-send -a "GeOS" -i "$FILE" "Снимок экрана сохранён" "Он также скопирован — можно вставить через Ctrl+V."
