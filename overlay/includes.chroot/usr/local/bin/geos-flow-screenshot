#!/bin/sh
# Снимок экрана в GeOS Flow: в буфер обмена и в папку «Изображения/Снимки экрана»
. /usr/local/lib/geos/i18n.sh
DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/$(T "Screenshots" "Снимки экрана")"
mkdir -p "$DIR"
FILE="$DIR/$(T "Screenshot" "Снимок") $(date +'%Y-%m-%d %H-%M-%S').png"
if [ "$1" = "area" ]; then
  AREA=$(slurp -b 0d1b3466 -c 3b82f6ff -w 2) || exit 0
  grim -g "$AREA" "$FILE" || exit 1
else
  grim "$FILE" || exit 1
fi
wl-copy < "$FILE"
notify-send -a "GeOS" -i "$FILE" "$(T "Screenshot saved" "Снимок экрана сохранён")" "$(T "It is also copied — paste it with Ctrl+V." "Он также скопирован — можно вставить через Ctrl+V.")"
