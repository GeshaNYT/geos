#!/bin/sh
# Полоски ▁▂▃▅▇ под музыку для панели и рабочего стола GeOS Flow.
# Пока ничего не играет — строка пустая, и полоски прячутся.
BARS=${1:-20}
command -v cava >/dev/null || exit 0
CONF=$(mktemp)
trap 'rm -f "$CONF"' EXIT INT TERM
sed "s/^bars = .*/bars = $BARS/" /usr/share/geos/flow/cava.conf > "$CONF"
cava -p "$CONF" | sed -u 's/;//g; s/0/▁/g; s/1/▂/g; s/2/▃/g; s/3/▄/g; s/4/▅/g; s/5/▆/g; s/6/▇/g; s/7/█/g; s/^\(▁\)*$//'
