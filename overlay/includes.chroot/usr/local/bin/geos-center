#!/usr/bin/env python3
# Центр GeOS — программы в один клик и быстрые настройки системы.
import shutil
import sys

from PyQt6.QtCore import QProcess, Qt
from PyQt6.QtGui import QIcon, QPixmap
from PyQt6.QtWidgets import (
    QApplication, QFrame, QGridLayout, QHBoxLayout, QLabel, QMessageBox,
    QPushButton, QScrollArea, QTabWidget, QVBoxLayout, QWidget,
)

LOGO = "/usr/share/pixmaps/geos-logo.png"
FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"

# (эмодзи, название, описание, Flatpak ID)
APPS = [
    ("🎮", "Steam", "Игры, в том числе для Windows", "com.valvesoftware.Steam"),
    ("⛏️", "Prism Launcher", "Minecraft с модами: Fabric, NeoForge", "org.prismlauncher.PrismLauncher"),
    ("💬", "Discord", "Голосовой чат и сообщества", "com.discordapp.Discord"),
    ("✈️", "Telegram", "Мессенджер", "org.telegram.desktop"),
    ("🌐", "Google Chrome", "Браузер от Google", "com.google.Chrome"),
    ("🧑‍💻", "VS Code", "Редактор кода", "com.visualstudio.code"),
    ("🎥", "OBS Studio", "Запись экрана и стримы", "com.obsproject.Studio"),
    ("🎵", "Spotify", "Музыка", "com.spotify.Client"),
    ("🎬", "VLC", "Видеоплеер для любых форматов", "org.videolan.VLC"),
    ("🎨", "GIMP", "Редактор изображений", "org.gimp.GIMP"),
    ("🍷", "Bottles", "Удобный запуск Windows-программ", "com.usebottles.bottles"),
    ("📝", "LibreOffice", "Документы, таблицы, презентации", "org.libreoffice.LibreOffice"),
]

# (эмодзи, название, описание, команда)
SYSTEM = [
    ("🤖", "Включить Android", "Подготовить запуск .apk (скачает ~1 ГБ)",
     ["pkexec", "waydroid", "init", "-s", "GAPPS"]),
    ("📱", "Связь с телефоном", "Файлы, уведомления и буфер обмена (KDE Connect)",
     ["kdeconnect-app"]),
    ("🪟", "Windows-программы", "Настройки запуска .exe (Wine)", ["winecfg"]),
    ("🕒", "Снимки системы", "Откат системы, если что-то сломалось (Timeshift)",
     ["timeshift-launcher"]),
    ("🛍️", "Все приложения", "Магазин Discover: тысячи программ", ["plasma-discover"]),
]

STYLE = """
QWidget { background: #0d1b34; color: #e6eefa; font-size: 14px; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #12264a; padding: 8px 18px; border-radius: 8px; margin: 4px; }
QTabBar::tab:selected { background: #2563eb; }
QFrame#card { background: #13284f; border-radius: 14px; }
QLabel#emoji { font-size: 32px; background: transparent; }
QLabel#name { font-size: 16px; font-weight: bold; background: transparent; }
QLabel#desc { color: #96aac8; background: transparent; }
QLabel#title { font-size: 26px; font-weight: bold; }
QLabel#subtitle { color: #96aac8; }
QPushButton { background: #2563eb; border: none; border-radius: 8px; padding: 7px 14px; font-weight: bold; }
QPushButton:hover { background: #3b82f6; }
QPushButton:disabled { background: #1e3a6e; color: #96aac8; }
QPushButton#open { background: #16a34a; }
QPushButton#open:hover { background: #22c55e; }
QScrollArea { border: none; }
"""


def installed_apps():
    if not shutil.which("flatpak"):
        return set()
    p = QProcess()
    p.start("flatpak", ["list", "--app", "--columns=application"])
    p.waitForFinished(10000)
    return set(bytes(p.readAllStandardOutput()).decode().split())


def card(emoji, name, desc, button):
    frame = QFrame(objectName="card")
    lay = QVBoxLayout(frame)
    lay.setContentsMargins(16, 14, 16, 14)
    for text, obj in ((emoji, "emoji"), (name, "name"), (desc, "desc")):
        lbl = QLabel(text, objectName=obj)
        lbl.setWordWrap(True)
        lay.addWidget(lbl)
    lay.addStretch()
    lay.addWidget(button)
    return frame


class Center(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Центр GeOS")
        self.setWindowIcon(QIcon(LOGO))
        self.resize(980, 680)
        self.queue = []
        self.proc = None
        self.buttons = {}

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 20, 24, 20)

        head = QHBoxLayout()
        logo = QLabel()
        logo.setPixmap(QPixmap(LOGO).scaled(64, 64, Qt.AspectRatioMode.KeepAspectRatio,
                                            Qt.TransformationMode.SmoothTransformation))
        head.addWidget(logo)
        texts = QVBoxLayout()
        texts.addWidget(QLabel("Центр GeOS", objectName="title"))
        self.status = QLabel("Программы в один клик — без терминала", objectName="subtitle")
        texts.addWidget(self.status)
        head.addLayout(texts)
        head.addStretch()
        root.addLayout(head)

        tabs = QTabWidget()
        tabs.addTab(self.apps_tab(), "Приложения")
        tabs.addTab(self.system_tab(), "Система")
        root.addWidget(tabs)

    def grid_page(self, cards):
        page = QWidget()
        grid = QGridLayout(page)
        grid.setSpacing(14)
        for i, c in enumerate(cards):
            grid.addWidget(c, i // 3, i % 3)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(page)
        return scroll

    def apps_tab(self):
        have = installed_apps()
        cards = []
        for emoji, name, desc, app_id in APPS:
            btn = QPushButton()
            self.buttons[app_id] = btn
            self.set_state(app_id, "open" if app_id in have else "install")
            btn.clicked.connect(lambda _, a=app_id, n=name: self.app_clicked(a, n))
            cards.append(card(emoji, name, desc, btn))
        return self.grid_page(cards)

    def system_tab(self):
        cards = []
        for emoji, name, desc, cmd in SYSTEM:
            btn = QPushButton("Открыть")
            btn.clicked.connect(lambda _, c=cmd: self.run_tool(c))
            cards.append(card(emoji, name, desc, btn))
        return self.grid_page(cards)

    def set_state(self, app_id, state):
        btn = self.buttons[app_id]
        btn.setObjectName("open" if state == "open" else "")
        btn.setText({"install": "Установить", "queued": "В очереди…",
                     "busy": "Установка…", "open": "Открыть"}[state])
        btn.setEnabled(state in ("install", "open"))
        btn.setProperty("state", state)
        btn.style().unpolish(btn)
        btn.style().polish(btn)

    def app_clicked(self, app_id, name):
        if self.buttons[app_id].property("state") == "open":
            QProcess.startDetached("flatpak", ["run", app_id])
            return
        self.queue.append((app_id, name))
        self.set_state(app_id, "queued")
        self.next_install()

    def next_install(self):
        if self.proc or not self.queue:
            return
        app_id, name = self.queue.pop(0)
        self.set_state(app_id, "busy")
        self.status.setText(f"Устанавливаю {name}… Это может занять несколько минут.")
        self.proc = QProcess(self)
        script = (f"flatpak remote-add --user --if-not-exists flathub {FLATHUB} && "
                  f"flatpak install --user -y --noninteractive flathub {app_id}")
        self.proc.finished.connect(lambda code, _s, a=app_id, n=name: self.install_done(a, n, code))
        self.proc.start("sh", ["-c", script])

    def install_done(self, app_id, name, code):
        err = bytes(self.proc.readAllStandardError()).decode().strip()
        self.proc = None
        if code == 0:
            self.set_state(app_id, "open")
            self.status.setText(f"{name} установлен ✔")
        else:
            self.set_state(app_id, "install")
            self.status.setText(f"Не удалось установить {name}")
            QMessageBox.warning(self, "Ошибка", f"{name} не установился.\n"
                                "Проверь интернет и попробуй ещё раз.\n\n" + err[-400:])
        self.next_install()

    def run_tool(self, cmd):
        if not shutil.which(cmd[0]):
            QMessageBox.information(self, "Центр GeOS", f"Программа {cmd[0]} не найдена.")
            return
        QProcess.startDetached(cmd[0], cmd[1:])


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setDesktopFileName("geos-center")
    app.setStyleSheet(STYLE)
    w = Center()
    w.show()
    sys.exit(app.exec())
