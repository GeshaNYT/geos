def is_live():
    try:
        return "boot=live" in open("/proc/cmdline").read()
    except OSError:
        return False


def user_name():
    import pwd
    try:
        full = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
    except KeyError:
        full = ""
    return full or os.environ.get("USER", tr("friend", ru="друг"))


def system_summary():
    parts = []
    try:
        cpu = next(l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name"))
        parts.append(re.sub(r"\s+", " ", cpu.replace("(R)", "").replace("(TM)", "")))
    except (OSError, StopIteration):
        pass
    try:
        kb = int(next(l.split()[1] for l in open("/proc/meminfo") if l.startswith("MemTotal")))
        parts.append(tr("{n} GB RAM", ru="{n} ГБ памяти").format(n=f"{kb / 1048576:.0f}"))
    except (OSError, StopIteration, ValueError):
        pass
    try:
        st = os.statvfs(os.path.expanduser("~"))
        parts.append(tr("{n} GB free", ru="{n} ГБ свободно").format(n=f"{st.f_bavail * st.f_frsize / 1024**3:.0f}"))
    except OSError:
        pass
    return "GeOS 1.0  ·  " + "  ·  ".join(parts)


def installed_apps():
    if not shutil.which("flatpak"):
        return set()
    p = QProcess()
    p.start("flatpak", ["list", "--app", "--columns=application"])
    p.waitForFinished(10000)
    return set(bytes(p.readAllStandardOutput()).decode().split())


def set_icon(label, pixmap):
    if pixmap and not pixmap.isNull():
        label.setPixmap(pixmap.scaled(ICON_SIZE, ICON_SIZE, Qt.AspectRatioMode.KeepAspectRatio,
                                      Qt.TransformationMode.SmoothTransformation))
        return True
    return False


def svg_icon(name):
    return ui.pixmap(name, ICON_SIZE * 2)


def card(icon_name, name, desc, *buttons):
    """Карточка программы. Возвращает (карточка, метка иконки)."""
    frame = QFrame(objectName="card")
    frame.setMinimumWidth(260)
    frame.setFixedHeight(200)
    lay = QVBoxLayout(frame)
    lay.setContentsMargins(16, 14, 16, 14)
    icon = QLabel(objectName="emoji")
    icon.setFixedHeight(ICON_SIZE + 4)
    set_icon(icon, svg_icon(icon_name))
    lay.addWidget(icon)
    for text, obj in ((name, "name"), (desc, "desc")):
        lbl = QLabel(text, objectName=obj)
        lbl.setWordWrap(True)
        lay.addWidget(lbl)
    lay.addStretch()
    row = QHBoxLayout()
    for i, b in enumerate(buttons):
        row.addWidget(b, 1 if i == 0 else 0)
    lay.addLayout(row)
    return frame, icon


def scroll(widget):
    s = QScrollArea()
    s.setWidgetResizable(True)
    s.setWidget(widget)
    return s


class Center(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(tr("GeOS Centre", ru="Центр GeOS"))
        self.setWindowIcon(QIcon(LOGO))
        self.resize(1000, 720)
        self.queue = []
        self.proc = None
        self.buttons, self.removers, self.icon_labels, self.cards = {}, {}, {}, []
        self.category = "all"
        self.net = QNetworkAccessManager(self)
        os.makedirs(CACHE, exist_ok=True)

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 20, 24, 20)

        head, self.status = ui.header("logo", tr("GeOS Centre", ru="Центр GeOS"),
                                       tr("Apps in one click — no terminal needed", ru="Программы в один клик — без терминала"))
        root.addLayout(head)

        tabs = QTabWidget()
        self.tabs = tabs
        tabs.addTab(self.home_tab(), tr("Home", ru="Главная"))
        tabs.addTab(self.apps_tab(), tr("Apps", ru="Приложения"))
        tabs.addTab(self.system_tab(), tr("System", ru="Система"))
        root.addWidget(tabs)

    # ---------- вкладка «Главная» ----------
    def home_tab(self):
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(4, 12, 4, 4)
        lay.setSpacing(16)

        name = user_name()
        greeting = (tr("Welcome to GeOS!", ru="Добро пожаловать в GeOS!") if name.lower() in ("geos", "geosuser")
                    else tr("Hi, {name}!", ru="Привет, {name}!").format(name=name))
        hello = QLabel(greeting, objectName="big")
        lay.addWidget(hello)
        lay.addWidget(QLabel(system_summary(), objectName="desc"))

        quick = QGridLayout()
        quick.setSpacing(14)
        actions = [
            ("store", tr("Install Apps", ru="Установить программы"), tr("Steam, Discord, Telegram and 20+ more", ru="Steam, Discord, Telegram и ещё 20+"),
             lambda: self.tabs.setCurrentIndex(1)),
            ("android", tr("Android Apps", ru="Android-приложения"), tr("Open .apk files with a double click", ru="Открывай .apk двойным кликом"),
             lambda: self.run_tool(["geos-task", "android"])),
            ("phone", tr("Phone Link", ru="Связь с телефоном"), tr("Files and notifications from your phone", ru="Файлы и уведомления с телефона"),
             lambda: self.run_tool(["kdeconnect-app"])),
            ("update", tr("Updates", ru="Обновления"), tr("Latest versions of the system and apps", ru="Свежие версии системы и программ"),
             lambda: self.run_tool(["plasma-discover", "--mode", "update"])),
        ]
        if os.path.exists("/usr/share/wayland-sessions/geos-flow.desktop") and \
                "Hyprland" not in os.environ.get("XDG_CURRENT_DESKTOP", ""):
            actions.append(("flow", tr("Try GeOS Flow", ru="Попробовать GeOS Flow"),
                            tr("Tiling windows and smooth animations", ru="Плиточные окна и плавные анимации"),
                            lambda: self.run_tool(["geos-session", "flow"])))
        installer = "/usr/share/applications/install-geos.desktop"
        if is_live() and os.path.exists(installer):
            actions.insert(0, ("disk", tr("Install GeOS", ru="Установить GeOS"),
                               tr("Install the system on this computer", ru="Поставить систему на этот компьютер"),
                               lambda: self.run_tool(["kioclient", "exec", installer])))
        cols = 2 if len(actions) == 4 else 3
        for i, (icon, name, desc, fn) in enumerate(actions[:6]):
            btn = QPushButton(tr("Open", ru="Открыть"))
            btn.clicked.connect(fn)
            frame, _ = card(icon, name, desc, btn)
            frame.setFixedHeight(170)
            quick.addWidget(frame, i // cols, i % cols)
        lay.addLayout(quick)

        lay.addWidget(QLabel(tr("Useful shortcuts", ru="Полезные клавиши"), objectName="name"))
        keys = QGridLayout()
        keys.setHorizontalSpacing(18)
        keys.setVerticalSpacing(8)
        keys.setColumnStretch(1, 1)
        keys.setColumnStretch(3, 1)
        for i, (k, what) in enumerate(SHORTCUTS):
            kl = QLabel(f"<b>{k}</b>")
            kl.setStyleSheet(f"color: {ui.ACCENT_HI}; background: transparent;")
            keys.addWidget(kl, i // 2, (i % 2) * 2)
            keys.addWidget(QLabel(what, objectName="desc"), i // 2, (i % 2) * 2 + 1)
        lay.addLayout(keys)
        lay.addStretch()
        return scroll(page)

    # ---------- вкладка «Приложения» ----------
    def apps_tab(self):
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(0, 8, 0, 0)

        self.search = QLineEdit(placeholderText=tr("Search apps…", ru="Поиск программы…"))
        self.search.textChanged.connect(self.refilter)
        lay.addWidget(self.search)

        chips = QHBoxLayout()
        group = QButtonGroup(self)
        for cat in CATEGORIES:
            b = QPushButton(CATEGORY_NAMES.get(cat, cat), objectName="chip", checkable=True)
            b.setChecked(cat == "all")
            b.clicked.connect(lambda _, c=cat: self.set_category(c))
            group.addButton(b)
            chips.addWidget(b)
        chips.addStretch()
        lay.addLayout(chips)

        have = installed_apps()
        for cat, name, desc, app_id in APPS:
            btn = QPushButton()
            rm = QPushButton(tr("Remove", ru="Удалить"), objectName="remove")
            rm.setToolTip(tr("Uninstall the app", ru="Удалить программу"))
            self.buttons[app_id], self.removers[app_id] = btn, rm
            btn.clicked.connect(lambda _, a=app_id, n=name: self.app_clicked(a, n))
            rm.clicked.connect(lambda _, a=app_id, n=name: self.remove_app(a, n))
            frame, icon = card(CATEGORY_ICONS.get(cat, "store"), name, desc, btn, rm)
            self.icon_labels[app_id] = icon
            self.set_state(app_id, "open" if app_id in have else "install")
            if not self.load_local_icon(app_id):
                self.fetch_icon(app_id)
            self.cards.append((cat, f"{name} {desc}".lower(), frame))

        self.grid_host = QWidget()
        self.grid = QGridLayout(self.grid_host)
        self.grid.setSpacing(14)
        self.grid.setAlignment(Qt.AlignmentFlag.AlignTop)
        self.empty = QLabel(tr("Nothing found. Try searching in the Discover store.",
                               ru="Ничего не нашлось. Попробуй поискать в магазине Discover."), objectName="desc")
        lay.addWidget(scroll(self.grid_host))
        self.refilter()
        return page

    def set_category(self, cat):
        self.category = cat
        self.refilter()

    def refilter(self):
        text = self.search.text().strip().lower()
        while self.grid.count():
            self.grid.takeAt(0).widget().setParent(None)
        shown = 0
        for cat, haystack, frame in self.cards:
            if (self.category in ("all", cat)) and (not text or text in haystack):
                self.grid.addWidget(frame, shown // COLUMNS, shown % COLUMNS)
                frame.show()
                shown += 1
        if not shown:
            self.grid.addWidget(self.empty, 0, 0, 1, COLUMNS)
            self.empty.show()

    # ---------- настоящие иконки программ ----------
    def load_local_icon(self, app_id):
        for d in LOCAL_ICON_DIRS:
            path = os.path.join(d, app_id + ".png")
            if os.path.exists(path) and set_icon(self.icon_labels[app_id], QPixmap(path)):
                return True
        return False

    def fetch_icon(self, app_id):
        """Нет иконки на диске — берём адрес официальной иконки из каталога Flathub."""
        reply = self.net.get(QNetworkRequest(QUrl(FLATHUB_API + app_id)))
        reply.finished.connect(lambda r=reply, a=app_id: self.got_appstream(r, a))

    def got_appstream(self, reply, app_id):
        try:
            url = json.loads(bytes(reply.readAll()).decode()).get("icon") or ""
        except (ValueError, AttributeError):
            url = ""
        reply.deleteLater()
        if url.startswith("https://"):
            img = self.net.get(QNetworkRequest(QUrl(url)))
            img.finished.connect(lambda r=img, a=app_id: self.got_icon(r, a))

    def got_icon(self, reply, app_id):
        raw = bytes(reply.readAll())
        reply.deleteLater()
        pix = QPixmap()
        if pix.loadFromData(raw) and set_icon(self.icon_labels[app_id], pix):
            pix.save(os.path.join(CACHE, app_id + ".png"), "PNG")

    # ---------- установка и удаление ----------
    def set_state(self, app_id, state):
        btn = self.buttons[app_id]
        btn.setObjectName("open" if state == "open" else "")
        btn.setText({"install": tr("Install", ru="Установить"), "queued": tr("Queued…", ru="В очереди…"),
                     "busy": tr("Installing…", ru="Установка…"), "removing": tr("Removing…", ru="Удаление…"),
                     "open": tr("Open", ru="Открыть")}[state])
        btn.setEnabled(state in ("install", "open"))
        btn.setProperty("state", state)
        btn.style().unpolish(btn)
        btn.style().polish(btn)
        self.removers[app_id].setVisible(state == "open")

    def app_clicked(self, app_id, name):
        if self.buttons[app_id].property("state") == "open":
            QProcess.startDetached("flatpak", ["run", app_id])
            return
        self.queue.append(("install", app_id, name))
        self.set_state(app_id, "queued")
        self.next_job()

    def remove_app(self, app_id, name):
        if QMessageBox.question(self, tr("GeOS Centre", ru="Центр GeOS"),
                                tr("Remove {name}?", ru="Удалить {name}?").format(name=name)) != QMessageBox.StandardButton.Yes:
            return
        self.queue.append(("remove", app_id, name))
        self.set_state(app_id, "queued")
        self.next_job()

    def next_job(self):
        if self.proc or not self.queue:
            return
        action, app_id, name = self.queue.pop(0)
        if action == "install":
            self.set_state(app_id, "busy")
            self.status.setText(tr("Installing {name}… This may take a few minutes.",
                                   ru="Устанавливаю {name}… Это может занять несколько минут.").format(name=name))
            script = (f"flatpak remote-add --user --if-not-exists flathub {FLATHUB} && "
                      f"flatpak install --user -y --noninteractive flathub {app_id} && "
                      "(flatpak install --user -y --noninteractive flathub org.gtk.Gtk3theme.Breeze || true)")
        else:
            self.set_state(app_id, "removing")
            self.status.setText(tr("Removing {name}…", ru="Удаляю {name}…").format(name=name))
            script = (f"flatpak uninstall --user -y --noninteractive {app_id} || "
                      f"pkexec flatpak uninstall --system -y --noninteractive {app_id}")
        self.proc = QProcess(self)
        self.proc.finished.connect(lambda code, _s, ac=action, a=app_id, n=name: self.job_done(ac, a, n, code))
        self.proc.start("sh", ["-c", script])

    def job_done(self, action, app_id, name, code):
        err = bytes(self.proc.readAllStandardError()).decode().strip()
        self.proc = None
        ok = code == 0
        if action == "install":
            self.set_state(app_id, "open" if ok else "install")
            self.status.setText((tr("{name} installed ✔ It is also in the Start menu now.",
                                    ru="{name} установлен ✔ Он также появился в меню «Пуск».") if ok
                                 else tr("Could not install {name}", ru="Не удалось установить {name}")).format(name=name))
        else:
            self.set_state(app_id, "install" if ok else "open")
            self.status.setText((tr("{name} removed", ru="{name} удалён") if ok
                                 else tr("Could not remove {name}", ru="Не удалось удалить {name}")).format(name=name))
        if not ok:
            low = err.lower()
            if "недостаточно места" in low or "no space" in low or "not enough space" in low or "insufficient" in low:
                if is_live():
                    why = tr("Not enough space. GeOS is running from a USB stick or ISO (live mode): "
                             "apps are installed straight into RAM, and there is little of it.\n\n"
                             "Install GeOS on a disk — there will be plenty of space. Or pick a smaller app.",
                             ru="Не хватило места. GeOS сейчас запущена с флешки (живой режим): "
                             "программы ставятся прямо в оперативную память, и её мало.\n\n"
                             "Установи GeOS на диск — там места хватит. Или выбери программу поменьше.")
                else:
                    why = tr("Not enough disk space. Free up some space (Disk Cleanup on the System tab) and try again.",
                             ru="Не хватило места на диске. Освободи место («Очистка диска» во вкладке «Система») и попробуй ещё раз.")
                QMessageBox.warning(self, tr("Low disk space", ru="Мало места"),
                                    tr("Could not install {name}.", ru="Не получилось установить {name}.").format(name=name)
                                    + "\n\n" + why)
            else:
                QMessageBox.warning(self, tr("Error", ru="Ошибка"),
                                    tr("Failed: {name}.\nCheck your internet connection and try again.",
                                       ru="Не получилось: {name}.\nПроверь интернет и попробуй ещё раз.").format(name=name)
                                    + "\n\n" + err[-400:])
        self.next_job()

    # ---------- вкладка «Система» ----------
    def system_tab(self):
        page = QWidget()
        grid = QGridLayout(page)
        grid.setSpacing(14)
        grid.setAlignment(Qt.AlignmentFlag.AlignTop)
        items = list(SYSTEM)
        if os.path.exists("/usr/share/wayland-sessions/geos-flow.desktop"):
            if "Hyprland" in os.environ.get("XDG_CURRENT_DESKTOP", ""):
                items.insert(0, ("logo", tr("Classic mode", ru="Классический режим"),
                                 tr("Back to the familiar GeOS desktop", ru="Вернуться к привычному рабочему столу GeOS"),
                                 ["geos-session", "classic"]))
            else:
                items.insert(0, ("flow", tr("GeOS Flow mode", ru="Режим GeOS Flow"),
                                 tr("Windows arrange themselves, smooth animations", ru="Окна раскладываются сами, плавные анимации"),
                                 ["geos-session", "flow"]))
        frames = []
        for icon_name, name, desc, cmd in items:
            btn = QPushButton(tr("Open", ru="Открыть"))
            btn.clicked.connect(lambda _, c=cmd: self.run_tool(c))
            frames.append(card(icon_name, name, desc, btn)[0])
        # Полоски под музыку на рабочем столе (в обычном режиме по умолчанию выкл, в GeOS Flow — вкл)
        if shutil.which("geos-visualizer"):
            self.viz_btn = QPushButton()
            self.viz_btn.clicked.connect(self.toggle_visualizer)
            self.update_viz_button()
            frames.insert(1, card("viz", tr("Music bars", ru="Полоски под музыку"),
                                  tr("Glowing music visualizer on the desktop", ru="Светящийся визуализатор на рабочем столе"),
                                  self.viz_btn)[0])
        for i, frame in enumerate(frames):
            grid.addWidget(frame, i // COLUMNS, i % COLUMNS)
        return scroll(page)

    def update_viz_button(self):
        on = subprocess.run(["geos-visualizer", "--status"], capture_output=True, text=True).stdout.strip() == "on"
        self.viz_on = on
        self.viz_btn.setText(tr("Turn off", ru="Выключить") if on else tr("Turn on", ru="Включить"))
        self.viz_btn.setObjectName("open" if on else "")
        self.viz_btn.style().unpolish(self.viz_btn)
        self.viz_btn.style().polish(self.viz_btn)

    def toggle_visualizer(self):
        subprocess.run(["geos-visualizer", "--toggle"])
        self.update_viz_button()
        if self.viz_on:
            self.status.setText(tr("Bars are on — play some music and look at the desktop ✔",
                                   ru="Полоски включены — включи музыку и посмотри на рабочий стол ✔"))

    def run_tool(self, cmd):
        if not shutil.which(cmd[0]):
            QMessageBox.information(self, tr("GeOS Centre", ru="Центр GeOS"),
                                    tr("Program {p} not found.", ru="Программа {p} не найдена.").format(p=cmd[0]))
            return
        QProcess.startDetached(cmd[0], cmd[1:])


if __name__ == "__main__":
    app = QApplication(sys.argv)
    ui.apply(app, "geos-center")
    w = Center()
    w.show()
    sys.exit(app.exec())
