#!/bin/sh
# Меню выключения GeOS Flow
. /usr/local/lib/geos/i18n.sh
CHOICE=$(printf '🔒  %s\n💤  %s\n🔄  %s\n⏻  %s\n🖥  %s\n🚪  %s\n' \
  "$(T "Lock" "Заблокировать")" "$(T "Sleep" "Спящий режим")" "$(T "Restart" "Перезагрузить")" \
  "$(T "Shut down" "Выключить")" "$(T "Switch to GeOS (classic)" "Перейти в GeOS (классический)")" \
  "$(T "Log out" "Выйти из сеанса")" \
  | fuzzel --config /usr/share/geos/flow/fuzzel.ini --dmenu --prompt "GeOS ❯ " --lines 6 --width 34)
case "$CHOICE" in
  🔒*) hyprlock -c /usr/share/geos/flow/hyprlock.conf ;;
  💤*) systemctl suspend ;;
  🔄*) systemctl reboot ;;
  ⏻*)  systemctl poweroff ;;
  🖥*) /usr/local/bin/geos-session classic ;;
  🚪*) hyprctl dispatch exit ;;
esac
