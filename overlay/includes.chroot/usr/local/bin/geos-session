#!/bin/sh
# Переключение режима рабочего стола: classic (KDE Plasma) или flow (Hyprland)
. /usr/local/lib/geos/i18n.sh
case "$1" in
  flow)    SESSION=geos-flow.desktop; NAME="GeOS Flow" ;;
  classic) SESSION=plasma.desktop;    NAME="$(T "GeOS (classic)" "GeOS (классический)")" ;;
  *) echo "Usage: geos-session classic|flow"; exit 2 ;;
esac
if [ "$1" = "flow" ] && [ ! -f /usr/share/wayland-sessions/geos-flow.desktop ]; then
  kdialog --title "GeOS" --error "$(T "GeOS Flow is not included in this build." "Режим GeOS Flow не установлен в этой сборке.")"
  exit 1
fi
if [ "$1" = "flow" ] && [ "$(systemd-detect-virt 2>/dev/null)" = "oracle" ]; then
  kdialog --title "GeOS" --sorry "$(T "GeOS Flow does not work in VirtualBox: Hyprland needs a real graphics card with acceleration.\n\nTry GeOS Flow from a USB stick on a regular computer." "GeOS Flow не работает в VirtualBox: Hyprland нужна настоящая видеокарта с ускорением.\n\nПопробуй GeOS Flow с флешки на обычном компьютере.")"
  exit 0
fi
kdialog --title "GeOS" --yesno "$(T "Switch to “$NAME” mode?\n\nOpen apps will close — save your work." "Перейти в режим «$NAME»?\n\nОткрытые программы закроются — сохрани свою работу.")" || exit 0

export SUDO_ASKPASS=/usr/local/bin/geos-askpass
sudo -A sh -c "
  # Экран входа запоминает выбранный режим
  mkdir -p /var/lib/sddm
  if grep -q '^Session=' /var/lib/sddm/state.conf 2>/dev/null; then
    sed -i 's#^Session=.*#Session=/usr/share/wayland-sessions/$SESSION#' /var/lib/sddm/state.conf
  else
    printf '[Last]\nSession=/usr/share/wayland-sessions/$SESSION\n' >> /var/lib/sddm/state.conf
  fi
  # Автовход (живой режим с флешки) — сразу в выбранный режим
  for f in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
    [ -f \"\$f\" ] && grep -q '^\[Autologin\]' \"\$f\" && grep -q '^User=' \"\$f\" && \
      sed -i '/^\[Autologin\]/,/^\[/{s#^Session=.*#Session=$SESSION#}' \"\$f\" && \
      { grep -q '^Session=' \"\$f\" || sed -i '/^\[Autologin\]/a Session=$SESSION' \"\$f\"; }
  done
  true
" || exit 1

# Экран входа (SDDM) читает настройки только при своём запуске — поэтому перезапускаем его,
# иначе он пустит обратно в старый режим. Сеанс при этом закрывается.
sudo -A systemctl restart sddm || case "$XDG_CURRENT_DESKTOP" in
  *Hyprland*) hyprctl dispatch exit ;;
  *) dbus-send --session --type=method_call --dest=org.kde.Shutdown /Shutdown org.kde.Shutdown.logout ;;
esac
