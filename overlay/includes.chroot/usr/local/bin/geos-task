#!/usr/bin/env python3
# Окно выполнения задач GeOS: подготовка Android, очистка диска и т. д.
# Скрипт сообщает о ходе работы строками ::step / ::ok / ::warn / ::fail / ::done / ::ask.
import os
import re
import sys

from PyQt6.QtCore import QProcess, QProcessEnvironment, Qt
from PyQt6.QtWidgets import (
    QApplication, QHBoxLayout, QLabel, QMessageBox, QPlainTextEdit, QProgressBar,
    QPushButton, QVBoxLayout, QWidget,
)

import geos_ui as ui

TASKS = {
    "android": ("/usr/local/bin/geos-android-setup", "android", "Android в GeOS",
                "Подготовка запуска .apk-приложений"),
    "cleanup": ("/usr/local/bin/geos-cleanup", "cleanup", "Очистка диска",
                "Удаляю ненужные файлы и освобождаю место"),
}
SIZE_RE = re.compile(r"([\d.]+)\s*MB\s*/\s*([\d.]+)\s*MB")
PCT_RE = re.compile(r"(\d{1,3}(?:\.\d+)?)\s*%")
MARK = {"run": ("●", ui.ACCENT_HI), "ok": ("✔", ui.OK_HI), "warn": ("!", "#fbbf24"), "fail": ("✖", ui.BAD)}


class Task(QWidget):
    def __init__(self, script, icon, title, subtitle):
        super().__init__()
        self.setWindowTitle(title)
        self.resize(620, 460)
        self.result = 1
        self.current = None

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 20, 24, 20)
        root.setSpacing(14)
        head, self.sub = ui.header(icon, title, subtitle, 56)
        root.addLayout(head)

        self.bar = QProgressBar(textVisible=False)
        self.bar.setFixedHeight(8)
        self.bar.setRange(0, 0)
        root.addWidget(self.bar)

        self.steps = QVBoxLayout()
        self.steps.setSpacing(6)
        root.addLayout(self.steps)
        root.addStretch()

        self.log = QPlainTextEdit(readOnly=True)
        self.log.setMaximumBlockCount(2000)
        self.log.hide()
        root.addWidget(self.log, 1)

        row = QHBoxLayout()
        self.details = QPushButton("Подробности ▾", objectName="flat")
        self.details.clicked.connect(self.toggle_log)
        row.addWidget(self.details)
        row.addStretch()
        self.close_btn = QPushButton("Отмена")
        self.close_btn.clicked.connect(self.close)
        row.addWidget(self.close_btn)
        root.addLayout(row)

        self.proc = QProcess(self)
        env = QProcessEnvironment.systemEnvironment()
        env.insert("SUDO_ASKPASS", "/usr/local/bin/geos-askpass")
        env.insert("LANG", os.environ.get("LANG", "ru_RU.UTF-8"))
        self.proc.setProcessEnvironment(env)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read)
        self.proc.finished.connect(self.finished)
        self.buf = ""
        self.proc.start("bash", [script])

    def toggle_log(self):
        self.log.setVisible(not self.log.isVisible())
        self.details.setText("Подробности ▴" if self.log.isVisible() else "Подробности ▾")

    def add_step(self, text):
        self.finish_step("ok")
        lbl = QLabel()
        self.steps.addWidget(lbl)
        self.current = [lbl, text]
        self.paint(lbl, "run", text)
        self.bar.setRange(0, 0)

    def finish_step(self, kind, text=None):
        if self.current:
            lbl, old = self.current
            self.paint(lbl, kind, text or old)
            self.current = None

    @staticmethod
    def paint(lbl, kind, text):
        sym, color = MARK[kind]
        lbl.setText(f'<span style="color:{color}; font-weight:bold">{sym}</span>&nbsp;&nbsp;{text}')

    def read(self):
        self.buf += bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        parts = re.split(r"[\r\n]", self.buf)
        self.buf = parts.pop()
        for line in parts:
            self.handle(line.strip())

    def handle(self, line):
        if not line:
            return
        if line.startswith("::"):
            cmd, _, text = line[2:].partition(" ")
            if cmd == "step":
                self.add_step(text)
            elif cmd in ("ok", "warn"):
                self.finish_step(cmd, text or None)
            elif cmd == "fail":
                self.finish_step("fail", text)
                self.sub.setText(text)
            elif cmd == "done":
                self.finish_step("ok")
                self.sub.setText(text)
            elif cmd == "ask":
                yes = QMessageBox.question(self, self.windowTitle(), text) == QMessageBox.StandardButton.Yes
                self.proc.write(b"y\n" if yes else b"n\n")
            return
        self.log.appendPlainText(line)
        m = SIZE_RE.search(line)
        pct = 100 * float(m.group(1)) / max(float(m.group(2)), 0.01) if m else None
        if pct is None and (m := PCT_RE.search(line)):
            pct = float(m.group(1))
        if pct is not None and 0 <= pct <= 100:
            self.bar.setRange(0, 100)
            self.bar.setValue(int(pct))

    def finished(self, code, _status):
        self.read()
        if self.buf:
            self.handle(self.buf.strip())
        self.result = code
        self.bar.setRange(0, 100)
        self.bar.setValue(100 if code == 0 else 0)
        if code == 0:
            self.finish_step("ok")
        else:
            self.finish_step("fail")
            if not self.log.isVisible():
                self.toggle_log()
        self.close_btn.setText("Готово" if code == 0 else "Закрыть")

    def closeEvent(self, e):
        if self.proc.state() != QProcess.ProcessState.NotRunning:
            if QMessageBox.question(self, self.windowTitle(), "Прервать выполнение?") != QMessageBox.StandardButton.Yes:
                e.ignore()
                return
            self.proc.kill()
        e.accept()


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in TASKS:
        print("Использование: geos-task " + "|".join(TASKS))
        sys.exit(2)
    app = QApplication(sys.argv)
    ui.apply(app, "geos-center")
    w = Task(*TASKS[sys.argv[1]])
    w.show()
    app.exec()
    sys.exit(w.result)
