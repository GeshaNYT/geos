#!/usr/bin/env python3
# Визуализатор музыки GeOS: светящиеся полоски на рабочем столе, которые прыгают в такт звуку.
#   geos-visualizer            — показать полоски
#   geos-visualizer --enable   — включить (и запускать при входе)
#   geos-visualizer --disable  — выключить
#   geos-visualizer --toggle   — переключить
#   geos-visualizer --status   — напечатать on/off
import fcntl
import os
import shutil
import subprocess
import sys
import tempfile

from PyQt6.QtCore import QProcess, QRectF, Qt, QTimer
from PyQt6.QtGui import QColor, QGuiApplication, QLinearGradient, QPainter
from PyQt6.QtWidgets import QApplication, QWidget

APP_ID = "geos-visualizer"
BARS = 40
MAX = 100
AUTOSTART = os.path.expanduser("~/.config/autostart/geos-visualizer.desktop")   # обычный режим: по умолчанию выкл
FLOW_OFF = os.path.expanduser("~/.config/geos/flow-visualizer-off")             # GeOS Flow: по умолчанию вкл
FLOW = "Hyprland" in os.environ.get("XDG_CURRENT_DESKTOP", "")
GTK_BACKEND = "/usr/local/lib/geos/geos-visualizer-gtk"   # для GeOS Flow (Hyprland)
LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()), "geos-visualizer.lock")
CAVA_CONF = f"""
[general]
framerate = 60
bars = {BARS}
autosens = 1
[input]
method = pulse
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = {MAX}
bar_delimiter = 59
frame_delimiter = 10
[smoothing]
noise_reduction = 60
"""


# ---------- включение / выключение ----------
def running_pids():
    out = subprocess.run(["pgrep", "-f", f"/usr/local/bin/{APP_ID}$|{GTK_BACKEND}$"],
                         capture_output=True, text=True).stdout.split()
    return [int(p) for p in out if int(p) != os.getpid()]


def is_enabled():
    return not os.path.exists(FLOW_OFF) if FLOW else os.path.exists(AUTOSTART)


def kwin_rule(x, y, w, h):
    """Правило KWin: окно лежит под всеми окнами, без рамки, не в панели задач, не берёт фокус."""
    if not shutil.which("kwriteconfig6"):
        return
    rid = "geos-visualizer"
    rules = subprocess.run(["kreadconfig6", "--file", "kwinrulesrc", "--group", "General", "--key", "rules"],
                           capture_output=True, text=True).stdout.strip()
    ids = [r for r in rules.split(",") if r and r != rid] + [rid]
    w_ = lambda group, key, val: subprocess.run(
        ["kwriteconfig6", "--file", "kwinrulesrc", "--group", group, "--key", key, str(val)])
    w_("General", "rules", ",".join(ids))
    w_("General", "count", len(ids))
    for key, val in {
        "Description": "Визуализатор GeOS", "wmclass": APP_ID, "wmclassmatch": 1,
        "below": "true", "belowrule": 2, "skiptaskbar": "true", "skiptaskbarrule": 2,
        "skippager": "true", "skippagerrule": 2, "skipswitcher": "true", "skipswitcherrule": 2,
        "noborder": "true", "noborderrule": 2, "acceptfocus": "false", "acceptfocusrule": 2,
        "position": f"{x},{y}", "positionrule": 2, "size": f"{w},{h}", "sizerule": 2,
        "opacityactive": 100, "opacityactiverule": 2, "opacityinactive": 100, "opacityinactiverule": 2,
    }.items():
        w_(rid, key, val)
    subprocess.run(["dbus-send", "--session", "--type=method_call", "--dest=org.kde.KWin",
                    "/KWin", "org.kde.KWin.reconfigure"])


def enable():
    if FLOW:
        if os.path.exists(FLOW_OFF):
            os.remove(FLOW_OFF)
    else:
        os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
        with open(AUTOSTART, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Визуализатор GeOS\n"
                    f"Exec=/usr/local/bin/{APP_ID}\nOnlyShowIn=KDE;\nNoDisplay=true\n")
    if not running_pids():
        subprocess.Popen([f"/usr/local/bin/{APP_ID}"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def disable():
    if FLOW:
        os.makedirs(os.path.dirname(FLOW_OFF), exist_ok=True)
        open(FLOW_OFF, "w").close()
    elif os.path.exists(AUTOSTART):
        os.remove(AUTOSTART)
    for pid in running_pids():
        try:
            os.kill(pid, 15)
        except OSError:
            pass


# ---------- окно с полосками ----------
class Visualizer(QWidget):
    def __init__(self, geometry):
        super().__init__()
        self.setWindowTitle("Визуализатор GeOS")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnBottomHint
                            | Qt.WindowType.WindowTransparentForInput | Qt.WindowType.WindowDoesNotAcceptFocus)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating)
        self.setGeometry(*geometry)
        self.target = [0.0] * BARS
        self.level = [0.0] * BARS
        self.visible_amount = 0.0   # плавное появление и исчезновение
        self.silent_frames = 0
        self.buf = ""

        self.conf = tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False)
        self.conf.write(CAVA_CONF)
        self.conf.close()
        self.proc = QProcess(self)
        self.proc.readyReadStandardOutput.connect(self.read)
        self.proc.start("cava", ["-p", self.conf.name])

        self.timer = QTimer(self, interval=16, timeout=self.tick)
        self.timer.start()

    def read(self):
        self.buf += bytes(self.proc.readAllStandardOutput()).decode(errors="ignore")
        lines = self.buf.split("\n")
        self.buf = lines.pop()
        if lines:
            vals = [v for v in lines[-1].split(";") if v.strip()]
            if len(vals) >= BARS:
                self.target = [min(int(v), MAX) / MAX for v in vals[:BARS]]

    def tick(self):
        loud = any(t > 0.02 for t in self.target)
        self.silent_frames = 0 if loud else self.silent_frames + 1
        show = self.silent_frames < 90  # ~1,5 с тишины — полоски плавно прячутся
        self.visible_amount += ((1.0 if show else 0.0) - self.visible_amount) * 0.08
        for i, t in enumerate(self.target):
            k = 0.45 if t > self.level[i] else 0.12      # быстро вверх, плавно вниз
            self.level[i] += (t - self.level[i]) * k
        self.update()

    def paintEvent(self, _):
        if self.visible_amount < 0.01:
            return
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setOpacity(self.visible_amount)
        w, h = self.width(), self.height()
        gap = max(4.0, w / BARS * 0.28)
        bw = (w - gap * (BARS - 1)) / BARS
        for i, lv in enumerate(self.level):
            bh = max(6.0, lv * (h - 16))
            x = i * (bw + gap)
            rect = QRectF(x, h - bh, bw, bh)
            grad = QLinearGradient(0, h - bh, 0, h)
            grad.setColorAt(0, QColor(56, 189, 248, 235))
            grad.setColorAt(1, QColor(37, 99, 235, 200))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(59, 130, 246, 50))                     # мягкое свечение
            p.drawRect(rect.adjusted(-3, -3, 3, 0))
            p.setBrush(grad)
            p.drawRect(rect)
        p.end()

    def closeEvent(self, e):
        self.proc.kill()
        os.unlink(self.conf.name)
        e.accept()


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--status":
        print("on" if is_enabled() else "off")
        return
    if arg == "--enable":
        enable()
        return
    if arg == "--disable":
        disable()
        return
    if arg == "--toggle":
        disable() if is_enabled() else enable()
        return
    if not shutil.which("cava"):
        print("cava не установлен")
        sys.exit(1)
    if FLOW:
        # Hyprland не умеет «окно под всеми окнами», поэтому там полоски рисует отдельная
        # программа-слой рабочего стола (layer-shell) — с тем же видом, что и здесь
        if not is_enabled():
            return
        env = dict(os.environ)
        for lib in ("/usr/lib/x86_64-linux-gnu/libgtk-layer-shell.so.0",):
            if os.path.exists(lib):
                env["LD_PRELOAD"] = lib
        os.execve("/usr/bin/python3", ["/usr/bin/python3", GTK_BACKEND], env)

    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)  # только одна копия
    except OSError:
        return

    app = QApplication(sys.argv)
    app.setDesktopFileName(APP_ID)
    scr = QGuiApplication.primaryScreen().availableGeometry()
    # На Wayland Qt не знает, где панель, поэтому отступ снизу берём с запасом под панель GeOS
    w, h = int(scr.width() * 0.7), 170
    x, y = scr.x() + (scr.width() - w) // 2, scr.y() + scr.height() - h - 96
    kwin_rule(x, y, w, h)
    v = Visualizer((x, y, w, h))
    v.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
