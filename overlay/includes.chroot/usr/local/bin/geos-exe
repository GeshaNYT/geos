#!/bin/sh
# Запуск Windows-программ (.exe, .msi) через Wine
. /usr/local/lib/geos/i18n.sh
[ -f "$1" ] || { kdialog --title "GeOS" --error "$(T "File not found:" "Файл не найден:") $1"; exit 1; }
/usr/local/bin/geos-wine-setup
case "$1" in
  *.msi|*.MSI) exec wine msiexec /i "$1" ;;
  *)           exec wine start /unix "$1" ;;
esac
