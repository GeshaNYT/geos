#!/bin/sh
# Готовит Wine для Windows-программ: создаёт среду и красит окна в цвета GeOS (один раз)
. /usr/local/lib/geos/i18n.sh
export WINEDEBUG=-all
FLAG="${WINEPREFIX:-$HOME/.wine}/.geos-style"
[ -f "$FLAG" ] && exit 0
notify-send -a "GeOS" -i wine "$(T "Preparing to run Windows programs" "Готовлю запуск Windows-программ")" "$(T "This is needed once and takes about a minute…" "Это нужно один раз и займёт около минуты…")"
wineboot -i >/dev/null 2>&1
wine regedit /S /usr/share/geos/wine-geos.reg >/dev/null 2>&1
wineserver -w 2>/dev/null
touch "$FLAG"
