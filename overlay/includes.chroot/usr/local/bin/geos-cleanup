#!/bin/bash
# Очистка диска GeOS — как «Очистка диска» в Windows. Ход работы показывает окно geos-task.
. /usr/local/lib/geos/i18n.sh
step() { echo "::step $*"; }
ok()   { echo "::ok $*"; }
free_mb() { df -m --output=avail / | tail -1 | tr -d ' '; }
BEFORE=$(free_mb)

step "$(T "Downloaded update cache" "Кэш загруженных обновлений")";    sudo -A apt-get clean; ok
step "$(T "Unneeded system packages" "Ненужные системные пакеты")";      sudo -A apt-get autoremove -y --purge; ok
step "$(T "Unused app components" "Неиспользуемые компоненты приложений")"
flatpak uninstall --user --unused -y --noninteractive 2>&1
sudo -A flatpak uninstall --system --unused -y --noninteractive 2>&1
ok
step "$(T "Old system logs" "Старые системные журналы")";       sudo -A journalctl --vacuum-time=14d 2>&1; ok
step "$(T "Thumbnails and temporary files" "Миниатюры и временные файлы")";    rm -rf "$HOME/.cache/thumbnails"; ok

if [ -n "$(ls -A "$HOME/.local/share/Trash/files" 2>/dev/null)" ]; then
  echo "::ask $(T "There are files in the Bin. Empty the Bin?" "В корзине есть файлы. Очистить корзину?")"
  read -r a
  if [ "$a" = "y" ]; then
    step "$(T "Emptying the Bin" "Очищаю корзину")"
    rm -rf "$HOME/.local/share/Trash/files/"* "$HOME/.local/share/Trash/info/"*
    ok
  fi
fi

AFTER=$(free_mb)
FREED=$(( AFTER - BEFORE > 0 ? AFTER - BEFORE : 0 ))
echo "::done $(T "Freed: $FREED MB. Free disk space: $(( AFTER / 1024 )) GB." "Освобождено: $FREED МБ. Свободно на диске: $(( AFTER / 1024 )) ГБ.")"
