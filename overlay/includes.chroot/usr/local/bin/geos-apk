#!/bin/bash
# Установка .apk двойным кликом через Waydroid
APK="$1"
[ -f "$APK" ] || { kdialog --error "Файл не найден: $APK"; exit 1; }

if [ ! -f /var/lib/waydroid/waydroid.cfg ]; then
  kdialog --msgbox "Первый запуск Android: скачаю образ (~1 ГБ). Это займёт несколько минут."
  pkexec waydroid init -s GAPPS || { kdialog --error "Не удалось подготовить Android."; exit 1; }
fi

pkexec systemctl start waydroid-container
if ! waydroid status | grep -q "RUNNING"; then
  waydroid session start >/dev/null 2>&1 &
  for i in $(seq 1 60); do waydroid status | grep -q "RUNNING" && break; sleep 2; done
fi

if waydroid app install "$APK"; then
  notify-send -i android "GeOS" "Приложение установлено: $(basename "$APK")"
else
  kdialog --error "Не удалось установить $(basename "$APK")"
fi
