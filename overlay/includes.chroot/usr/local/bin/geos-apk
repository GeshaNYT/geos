#!/bin/bash
# Установка .apk двойным кликом через Waydroid
. /usr/local/lib/geos/i18n.sh
APK="$1"
NAME=$(basename "$APK")
[ -f "$APK" ] || { kdialog --title "GeOS" --error "$(T "File not found:" "Файл не найден:") $APK"; exit 1; }

ready() { [ -s /var/lib/waydroid/images/system.img ] && waydroid status 2>/dev/null | grep -q "RUNNING"; }

if ! ready; then
  kdialog --title "GeOS" --yesno "$(T "To open $NAME, Android needs to be set up once.\nDo it now?" "Чтобы открыть $NAME, нужно один раз подготовить Android.\nСделать это сейчас?")" || exit 0
  /usr/local/bin/geos-task android || exit 1
fi

notify-send -a "GeOS" -i android "$(T "Installing $NAME…" "Устанавливаю $NAME…")"
if waydroid app install "$APK"; then
  notify-send -a "GeOS" -i android "$(T "Done" "Готово")" "$(T "$NAME is installed — it will appear in the Start menu." "$NAME установлено — оно появится в меню «Пуск».")"
else
  kdialog --title "GeOS" --error "$(T "Could not install $NAME.\nThe file may be damaged or not suitable for this Android version." "Не удалось установить $NAME.\nВозможно, файл повреждён или не подходит для этой версии Android.")"
fi
