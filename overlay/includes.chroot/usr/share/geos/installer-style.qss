/* Установщик GeOS: тёмно-синий, как вся система (скругления, синие кнопки, спокойный текст) */
QWidget {
    font-family: "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
    color: #e6eefa;
    background: #0f1d36;
}
QMainWindow, QDialog, #mainApp, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #0f1d36;
}
#sidebarApp, #sidebarMenuApp, #sidebarApp QWidget {
    background: #0a1428;
    color: #c9d6ee;
    border: none;
}
QLabel { background: transparent; color: #e6eefa; }
QLabel:disabled { color: #6b7d9c; }
/* Заголовок «Добро пожаловать» — поменьше и без лишнего шума */
#mainText { font-size: 15pt; font-weight: 600; color: #ffffff; }
a, QLabel[openExternalLinks="true"] { color: #60a5fa; }

QPushButton, QToolButton {
    background: #18294a;
    color: #e6eefa;
    border: 1px solid #284068;
    border-radius: 8px;
    padding: 6px 18px;
    min-height: 22px;
}
QPushButton:hover, QToolButton:hover { background: #20365f; border-color: #3b82f6; }
QPushButton:pressed, QToolButton:pressed { background: #1b3a75; }
QPushButton:disabled, QToolButton:disabled { color: #5d6f90; background: #132240; border-color: #1c2e50; }
QPushButton#view-button-next, QPushButton#view-button-install, QPushButton:default {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    font-weight: 600;
}
QPushButton#view-button-next:hover, QPushButton#view-button-install:hover, QPushButton:default:hover {
    background: #1d4ed8;
}
QPushButton#view-button-next:disabled { background: #1e3a6e; border-color: #1e3a6e; color: #8ea6cf; }

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit, QTextBrowser {
    background: #16284a;
    color: #e6eefa;
    border: 1px solid #284068;
    border-radius: 8px;
    padding: 5px 10px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #3b82f6; }
QLineEdit:disabled, QComboBox:disabled { color: #6b7d9c; background: #132240; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView, QMenu {
    background: #16284a;
    color: #e6eefa;
    border: 1px solid #284068;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}
QMenu::item { padding: 6px 18px; }
QMenu::item:selected { background: #2563eb; }

QListView, QTreeView, QTableView, QListWidget, QTreeWidget {
    background: #132544;
    color: #e6eefa;
    alternate-background-color: #16294b;
    border: 1px solid #22385e;
    border-radius: 10px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}
QListView::item, QTreeView::item { padding: 4px; border-radius: 6px; }
QListView::item:hover, QTreeView::item:hover { background: #1c3258; }
QHeaderView::section {
    background: #18294a;
    color: #b8c7e2;
    border: none;
    padding: 6px;
}
QGroupBox {
    border: 1px solid #22385e;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #b8c7e2; }
QTabWidget::pane { border: 1px solid #22385e; border-radius: 10px; }
QTabBar::tab { background: #18294a; color: #b8c7e2; padding: 6px 14px; border-radius: 6px; margin: 2px; }
QTabBar::tab:selected { background: #2563eb; color: #ffffff; }

QRadioButton, QCheckBox { spacing: 8px; background: transparent; }
QRadioButton::indicator, QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 2px solid #4b6390;
    background: #16284a;
}
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background: #2563eb; border-color: #60a5fa; }

QProgressBar {
    background: #18294a;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #e6eefa;
}
QProgressBar::chunk { background: #2563eb; border-radius: 6px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2a4370; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #3b82f6; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2a4370; border-radius: 4px; min-width: 30px; }
QSplitter::handle { background: #22385e; }
QToolTip { background: #0a1428; color: #e6eefa; border: 1px solid #284068; border-radius: 6px; padding: 6px; }

/* Кнопки внизу (Назад / Далее / Установить / Готово / Отмена) — одного размера и на одной линии,
   главная отличается только цветом */
QPushButton#view-button-back, QPushButton#view-button-next, QPushButton#view-button-install,
QPushButton#view-button-done, QPushButton#view-button-cancel, QPushButton:default {
    min-width: 92px;
    min-height: 26px;
    max-height: 26px;
    padding: 4px 16px;
    margin: 0px;
    font-weight: 600;
    border-width: 1px;
    border-style: solid;
}

/* Область слайдов во время установки — тёмная, без белой рамки */
QQuickWidget { background: #0f1d36; border: none; }
