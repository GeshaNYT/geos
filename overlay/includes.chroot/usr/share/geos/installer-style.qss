/* Установщик GeOS: современный вид в стиле системы (скругления, синие кнопки, крупные поля) */
QWidget {
    font-family: "Inter", "Noto Sans", sans-serif;
    font-size: 10.5pt;
}
#mainApp, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #f6f8fc;
    color: #0f172a;
}
#sidebarApp, #sidebarMenuApp {
    background: #0d1b34;
    color: #e6eefa;
    border: none;
}
QPushButton {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cfd8e8;
    border-radius: 8px;
    padding: 7px 18px;
    min-height: 22px;
}
QPushButton:hover { background: #eef3fd; border-color: #2563eb; }
QPushButton:pressed { background: #dbe6fb; }
QPushButton:disabled { color: #9aa6ba; background: #f1f4f9; border-color: #e3e8f1; }
QPushButton#view-button-next, QPushButton#view-button-install, QPushButton:default {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    font-weight: 600;
}
QPushButton#view-button-next:hover, QPushButton#view-button-install:hover, QPushButton:default:hover {
    background: #1d4ed8;
}
QPushButton#view-button-next:disabled { background: #93b4f5; border-color: #93b4f5; color: #eef3fd; }
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cfd8e8;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #2563eb; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #cfd8e8;
    border-radius: 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}
QListView, QTreeView, QTableView {
    background: #ffffff;
    border: 1px solid #dfe5ef;
    border-radius: 10px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}
QListView::item, QTreeView::item { padding: 5px; border-radius: 6px; }
QHeaderView::section {
    background: #eef2f8;
    color: #334155;
    border: none;
    padding: 6px;
}
QRadioButton, QCheckBox { spacing: 8px; }
QRadioButton::indicator, QCheckBox::indicator { width: 16px; height: 16px; }
QProgressBar {
    background: #e3e9f4;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #0f172a;
}
QProgressBar::chunk { background: #2563eb; border-radius: 6px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #c3cee0; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #2563eb; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #c3cee0; border-radius: 4px; min-width: 30px; }
QToolTip { background: #0d1b34; color: #e6eefa; border: none; border-radius: 6px; padding: 6px; }
